        "response": {
          "success": true,
          "message": "Logged out successfully"
        },
        "sideEffect": "Clears token cookie"
      },
      {
        "feature": "support-chat",
        "name": "AI support chat",
        "method": "POST",
        "path": "/support/chat",
        "url": "https://telnova.ai/api/support/chat",
        "authRequired": true,
        "request": {
          "messages": [
            {
              "role": "user|assistant",
              "content": "string"
            }
          ]
        },
        "successStatus": 200,
        "response": {
          "success": true,
          "message": "assistant response",
