  "features": [
    {
      "id": "F01",
      "name": "Authentication",
      "screens": [
        "Login",
        "Signup details",
        "Verification method",
        "OTP verify"
      ],
      "endpoints": [
        "/auth/signup",
        "/auth/verify-otp",
        "/auth/resend-otp",
        "/auth/signin",
        "/auth/me",
        "/auth/logout"
      ],
      "requirements": [
        "Complete auth flow: signup -> choose OTP channel (phone/email) -> verify OTP -> signin -> profile -> logout",
        "Email + password login",
        "Signup supports selectable OTP channel: phone (SMS) or email",
        "Store role and route to /dashboard for user role else /portal",
        "Persist session across app launches",
        "Show API error messages"
      ]
    },
    {
      "id": "F02",
      "name": "Sign up with OTP verification",
      "screens": ["Signup details", "Verification method", "OTP verify"],
      "endpoints": ["/auth/signup", "/auth/verify-otp", "/auth/resend-otp"],
      "requirements": [
        "Collect fullName, email, phoneNumber(E.164), password, confirmPassword",
        "Enforce password policy: min 8 + uppercase + lowercase + number + special",
        "Choose verificationType: email or phone",
        "OTP length must be exactly 6 digits",
        "Handle resend OTP cooldown using 429 remainingSeconds"
      ]
    },
    {
      "id": "F03",
      "name": "User support dashboard",
      "screens": ["Dashboard", "Chat panel", "Recent tickets panel"],
      "endpoints": [
        "/support/chat",
        "/support/ticket",
        "/support/ticket?limit=4"
      ],
      "requirements": [
        "Chat thread UI with user/assistant bubbles",
        "Send full message history to AI endpoint",
        "Play notification sound when assistant responds",
        "Auto-create ticket when user requests escalation/human support",
        "Close chat after ticket creation"
      ]
    },
    {
      "id": "F04",
      "name": "User tickets",
      "screens": ["Tickets list", "Ticket detail"],
      "endpoints": ["/support/ticket", "/support/ticket/{ticketNumber}"],
      "requirements": [
        "List own tickets with status and priority",
        "Filter list by status",
        "Open ticket detail with timestamps and conversation history"
      ]
    },
    {
      "id": "F05",
      "name": "Portal dashboard (non-user roles)",
      "screens": ["Portal home", "Role sidebar"],
      "endpoints": [],
      "requirements": [
        "Route admin/operator/partner users to portal",
        "Render role-based navigation visibility",
        "Admin dashboard metric cards currently static values"
      ]
    },
    {
      "id": "F06",
      "name": "Portal ticket operations (admin/operator)",
      "screens": ["Portal tickets list", "Ticket details dialog"],
      "endpoints": [
        "/support/tickets/all",
        "/support/tickets/{ticketNumber}/details",
        "/support/tickets/{ticketNumber}/resolve"
      ],
      "requirements": [
        "Paginated table of tickets",
        "Search + filters (status, priority)",
        "Open detailed ticket conversation",
        "Resolve open tickets"
      ]
    },
    {
      "id": "F07",
      "name": "Users management (admin only)",
      "screens": ["Users list", "Edit user modal"],
      "endpoints": ["/users", "/users/{userId}"],
      "requirements": [
        "Paginated searchable user table",
        "Edit role, active status, and subscription plan",
        "Restrict module to admin role"
      ]
    },
    {
      "id": "F08",
      "name": "Subscription pages",
      "screens": ["Subscription plans", "Current plan state"],
      "endpoints": [],
      "requirements": [
        "Render plans: monthly, yearly, lifetime",
        "Display current user plan",
        "Plan purchase/billing APIs are not implemented yet in backend"
      ]
    }
  ],
  "knownGapsAndNotes": [
    "Web UI includes statuses in_progress, waiting_customer, closed, but backend ticket model currently supports only open and resolved.",
    "Signin UI references 403 verification message, but signin API currently returns 400/401/500 paths in code.",
    "Portal admin dashboard metrics are static in frontend and not backed by APIs yet.",
    "Forgot password flow is present as UI link only; no reset-password API routes currently exposed."
  ],
  "flutterBuildRequirements": {
    "minimumModules": [
      "Authentication",
      "Role-based routing",
      "Support Chat",
      "User Tickets",
      "Portal Tickets",
      "Users Management",
      "Subscription UI"
    ],
    "recommendedPackages": [
      "dio (HTTP client)",
      "dio_cookie_manager + cookie_jar (session cookies)",
      "flutter_riverpod or bloc (state)",
      "go_router (navigation)",
      "shared_preferences or secure_storage (local persistence)",
      "flutter_svg (logo.svg)",
      "just_audio or audioplayers (notification sound)",
      "intl (date/time formatting)"
    ],
    "architecture": {
      "style": "feature-first",
      "layers": [
        "presentation",
        "application/state",
        "data/repositories",
        "network/api_client"
      ],
      "requiredClients": [
        "publicApiClient (unauthenticated)",
        "authApiClient (cookie-aware authenticated)"
      ]
    },
    "qualityRequirements": [
      "Null-safe Dart",
      "Centralized API error mapper",
      "Retry strategy only for idempotent GET calls",
      "Loading/empty/error states on every network screen",
      "Role guards for protected routes"
    ]
  },
  "assetIntegration": {
    "flutterPubspecExample": {
      "assets": [
        "assets/images/logo.svg",
        "assets/images/logo.png",
        "assets/audio/noti.mp3"
      ]
    },
    "logoRequirement": "Use project logos from assets/images in app header/auth screens/splash and avoid placeholder branding."
  }
