  "authAndSession": {
    "authType": "JWT stored in HTTP-only cookie named token (server checks cookies)",
    "loginResponseAlsoReturnsToken": true,
    "completeAuthFlow": {
      "steps": [
        "User signs up with fullName, email, phoneNumber, password.",
        "User chooses verification code delivery channel: phone (SMS) or email.",
        "Backend sends OTP using selected channel.",
        "User submits OTP for verification.",
        "After successful verification, user signs in with email/password.",
        "Backend sets token cookie and app fetches profile (/auth/me).",
        "Role-based redirect: user -> dashboard, admin/operator/partner -> portal.",
        "User can logout, which clears auth cookie."
      ],
      "otpDeliveryOptions": {
        "supported": ["phone", "email"],
        "signupField": "verificationType",
        "verifyField": "type",
        "resendField": "type",
        "otpExpiryMinutes": 5,
        "otpLength": 6
      }
    },
    "mobileImplementationRequirement": "Use an HTTP client with persistent cookie jar. Preserve and send Set-Cookie token for all authenticated API calls. If cookie handling is constrained, include Cookie header with token=<jwt> from login response.",
    "cookiePolicy": {
      "httpOnly": true,
      "secureInProduction": true,
      "sameSite": "strict",
      "path": "/",
      "maxAgeSeconds": 604800
    },
    "logoutBehavior": "POST /auth/logout clears token cookie"
  },
  "dataModels": {
    "User": {
      "fields": {
        "_id": "string",
        "fullName": "string",
        "email": "string",
        "password": "string (min 8, uppercase, lowercase, number, special @$!%*?&)",
        "phoneNumber": "string E.164",
        "emailVerified": "boolean",
        "phoneVerified": "boolean",
        "role": "user|operator|partner|admin",
        "isActive": "boolean",
        "subscription": {
          "status": "inactive|active|trialing|past_due|canceled|unpaid",
          "plan": "free|basic|premium|enterprise",
          "stripeCustomerId": "string|null",
          "stripeSubscriptionId": "string|null"
        }
      }
    },
    "Ticket": {
      "fields": {
        "ticketNumber": "string (TN + year + month + timestamp)",
        "userId": "ObjectId",
        "userEmail": "string",
        "userName": "string",
        "conversationHistory": [
          {
            "role": "user|assistant",
            "content": "string",
            "timestamp": "date"
          }
        ],
        "category": "Internet/Connectivity Issues|TV Service Issues|Mobile Service Issues|Billing & Payments|Installation & Technician|Equipment & Hardware|Account Management|Service Changes|Other",
        "priority": "low|medium|high|urgent",
        "status": "open|resolved",
        "resolvedAt": "date|null",
        "resolvedBy": "ObjectId|null"
      }
    }
  },
  "supportKnowledgeBase": {
    "sourceFile": "data/support-faq.json",
    "purpose": "FAQ-first responses for support chat before model generation",
    "shape": {
      "supportPhone": "string",
      "faqs": [
        {
          "id": "number",
          "question": "string",
          "answer": "string"
        }
      ]
    },
    "chatRuntimeBehavior": [
      "Support chat checks FAQ direct service-issue intents first.",
      "Then checks semantic FAQ match with threshold before OpenAI fallback.",
      "Support phone from FAQ file is appended to answers when missing."
    ]
  },
  "api": {
    "baseUrl": "https://telnova.ai/api",
    "common": {
      "contentType": "application/json",
      "authTransport": "cookie token",
      "errorShape": {
        "success": false,
        "message": "string"
      }
    },
    "endpoints": [
      {
        "feature": "auth",
        "name": "Signup",
        "method": "POST",
        "path": "/auth/signup",
        "url": "https://telnova.ai/api/auth/signup",
        "authRequired": false,
        "request": {
          "fullName": "string",
          "email": "string",
          "password": "string",
          "phoneNumber": "string E.164",
          "verificationType": "email|phone (default phone)"
        },
        "successStatus": 201,
        "response": {
          "success": true,
          "message": "string",
          "user": "user object without password",
          "requiresVerification": true,
          "verificationType": "email|phone"
        },
        "errors": [400, 409, 500]
      },
      {
        "feature": "auth",
        "name": "Verify OTP",
        "method": "POST",
        "path": "/auth/verify-otp",
        "url": "https://telnova.ai/api/auth/verify-otp",
        "authRequired": false,
        "request": {
          "userId": "string",
          "email": "string optional",
          "otp": "6-digit string",
          "type": "email|phone",
          "phoneMethod": "sms (optional)"
        },
        "successStatus": 200,
        "response": {
          "success": true,
          "message": "Email verified successfully | Phone verified successfully",
          "user": "updated user object"
        },
        "errors": [400, 404, 500]
      },
      {
        "feature": "auth",
        "name": "Resend OTP",
        "method": "POST",
        "path": "/auth/resend-otp",
        "url": "https://telnova.ai/api/auth/resend-otp",
        "authRequired": false,
        "request": {
          "userId": "string",
          "email": "string optional",
          "type": "email|phone (default email)",
          "purpose": "verification (default)"
        },
        "successStatus": 200,
        "response": {
          "success": true,
          "message": "OTP sent successfully via email|SMS",
          "expiresAt": "datetime"
        },
        "rateLimitBehavior": {
          "status": 429,
          "body": {
            "success": false,
            "message": "wait before requesting new OTP",
            "remainingSeconds": "number"
          }
        },
        "errors": [400, 404, 429, 500]
      },
      {
        "feature": "auth",
        "name": "Signin",
        "method": "POST",
        "path": "/auth/signin",
        "url": "https://telnova.ai/api/auth/signin",
        "authRequired": false,
        "request": {
          "email": "string",
          "password": "string"
        },
        "successStatus": 200,
        "response": {
          "success": true,
          "message": "Login successful",
          "user": "user object without password",
          "token": "jwt"
        },
        "sideEffect": "Sets HTTP-only cookie token",
        "errors": [400, 401, 500]
      },
      {
        "feature": "auth",
        "name": "Get profile",
        "method": "GET",
        "path": "/auth/me",
        "url": "https://telnova.ai/api/auth/me",
        "authRequired": true,
        "request": {},
        "successStatus": 200,
        "response": {
          "success": true,
          "user": "user object"
        },
        "errors": [401, 404, 500]
      },
      {
        "feature": "auth",
        "name": "Logout",
        "method": "POST",
        "path": "/auth/logout",
        "url": "https://telnova.ai/api/auth/logout",
        "authRequired": false,
        "request": {},
